# Leave DATABASE_URL unset locally: the SQLite file is backend/app.db whatever directory
# the server starts from. Render sets it to the Postgres URL (render.yaml).
# DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# optional — only if the idea uses AI. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default is gemini-3.5-flash-lite (~500 free requests/day). Full Flash models get only ~20/day free —
# check your project's real limits at https://aistudio.google.com/rate-limit before relying on one.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Whole-app cap on AI calls per day, enforced inside llm.complete() (protects the free
# quota from one person with a loop; routes with a fallback keep working past it)
# AI_DAILY_LIMIT=400/day
# Agent steps (the analyst's tool choices, the proposer's plans, the negotiating agents): the model and its thinking
# level ("minimal" keeps each step inside its 10-18 s budget; empty lets the model think).
# GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
# GEMINI_AGENT_THINKING=minimal
# The grid operator agent (Could an operator have stopped it?): defaults to the agent model; "low" thinking lets it reason a little more per call
# GEMINI_OPERATOR_MODEL=
# GEMINI_OPERATOR_THINKING=
# Tried in order when a model's quota is out (429): out for the day on a daily-quota 429, for a minute on a burst.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# Gemini answers cached on disk for 48 h (gitignored); empty turns it off (scripts/check.sh does).
# AI_CACHE_FILE=backend/.ai_cache.json

# Optional: ElevenLabs text-to-speech for the narrated incident briefing (MLH ElevenLabs track).
# Without it the app uses the browser's built-in voice. Key: elevenlabs.io → Profile → API keys.
ELEVENLABS_API_KEY=
# default eleven_multilingual_v2: the most natural, English + Spanish, twice the credits of eleven_flash_v2_5 (low latency, cheaper) (elevenlabs.io/docs/models)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Premade voice ids for the two speakers; blank = picked by name from the account's default voices
# ELEVENLABS_VOICE_PRESENTER=
# ELEVENLABS_VOICE_ANALYST=
# Whole-app cap on characters sent to ElevenLabs per day (Pacific); cached audio costs nothing
# VOICE_DAILY_CHARS=8000

# Startup warm-ups (1 = on, the local default; render.yaml turns each off on the free tier):
# DANGER_WARM=1
# FORECAST_PREWARM=1
# PLANTS_WARM=FL
# UNLOCK_WARM=FL:1000
# TIMELAPSE_WARM=1
# NARRATE_WARM=1
# Optional: a separate model for the public comment writer
# GEMINI_COMMENT_MODEL=
# Watch the story's director agent (default: GEMINI_MODEL); the paid key runs gemini-3.5-flash here
# GEMINI_SHOW_MODEL=gemini-3.5-flash
