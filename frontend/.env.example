# Backend URL for production builds (Vercel). Leave empty in dev — Vite proxies /api and /uploads.
VITE_API_URL=

# Demo identity: sign the app in as the seeded demo account automatically (no login screen).
# Must match backend/seed.py's DEMO_EMAIL/DEMO_PASSWORD. Public demo account, not a secret.
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=demo-password1
